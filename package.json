{
  "name": "amaru-ai-observatory",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:remote": "cross-env CLOUDFLARE_ENV=production vite",
    "build": "tsc -b && vite build && node scripts/sanitize-build-output.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "ingest:local": "tsx scripts/ingest-local-folder.ts",
    "ingest:watch": "tsx scripts/watch-local-folder.ts",
    "export:local-library": "tsx scripts/export-local-library.ts",
    "sources:health": "tsx scripts/check-source-health.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.0.1",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "maplibre-gl": "^5.24.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "workerd"
    ]
  }
}
